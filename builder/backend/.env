# Application

APP_NAME=WebsiteToApp Builder


# Security

SECRET_KEY=change_this_to_random_secret_key



# Database

DATABASE_URL=sqlite:///builder.db



# Redis Queue

REDIS_URL=redis://localhost:6379/0



# Build System

BUILD_FOLDER=./builds

TEMPLATE_FOLDER=../android-template



# Server

HOST=0.0.0.0

PORT=8000



# Android Build

GRADLE_COMMAND=./gradlew

BUILD_TYPE=release